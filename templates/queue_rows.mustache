{{!
    @template mod_requesthelp/queue_rows

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
{{#hasrequests}}
<div class="requesthelp-queue">
    {{#requests}}
    <article class="requesthelp-ticket {{statusclass}}">
        <div class="requesthelp-ticket-main">
            <div class="requesthelp-ticket-topline">
                <span class="requesthelp-status {{statusclass}}">{{status}}</span>
                <span class="requesthelp-subject">{{subject}}</span>
                <span class="requesthelp-wait">{{#str}}waitingtime, mod_requesthelp{{/str}}: <strong>{{waiting}}</strong></span>
            </div>
            <h3><a href="{{url}}">{{student}}</a></h3>
            <div class="requesthelp-description">{{{description}}}</div>
            <div class="requesthelp-meta">{{created}}{{#assigned}} · {{#str}}assignedto, mod_requesthelp{{/str}}: {{assigned}}{{/assigned}}</div>
        </div>
        <div class="requesthelp-ticket-actions">
            <a class="btn btn-outline-secondary btn-sm" href="{{url}}">{{#str}}viewrequest, mod_requesthelp{{/str}}</a>
            {{#canmarkanswered}}<form method="post" action="{{url}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="answered"><button class="btn btn-primary btn-sm" type="submit">{{#str}}markanswered, mod_requesthelp{{/str}}</button></form>{{/canmarkanswered}}
            {{#canresolve}}<form method="post" action="{{url}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="resolved"><button class="btn btn-success btn-sm" type="submit">{{#str}}resolve, mod_requesthelp{{/str}}</button></form>{{/canresolve}}
            {{#canreopen}}<form method="post" action="{{url}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="reopen"><button class="btn btn-secondary btn-sm" type="submit">{{#str}}reopen, mod_requesthelp{{/str}}</button></form>{{/canreopen}}
        </div>
    </article>
    {{/requests}}
</div>
{{/hasrequests}}
{{^hasrequests}}<div class="alert alert-info">{{#str}}norequests, mod_requesthelp{{/str}}</div>{{/hasrequests}}
